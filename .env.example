# ============================================================
# HH Bot Dashboard — переменные окружения для Docker
# Скопируй этот файл в .env и заполни значения
#
# Сгенерировать надёжный пароль:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# [ОБЯЗАТЕЛЬНО] Пароль для доступа к веб-дашборду (Basic Auth).
# НИКОГДА не оставляй пустым на сервере — дашборд будет открыт всем!
DASHBOARD_PASSWORD=

# Включить debug-эндпоинты (/api/debug/*).
# ВСЕГДА оставляй "false" в продакшне.
DEBUG_MODE=false

# Отключить SSL-верификацию для исходящих запросов к hh.ru.
# Оставь пустым (=включена) если нет MITM-прокси или корп. сертификатов.
DISABLE_SSL_VERIFY=
