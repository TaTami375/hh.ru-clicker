# ============================================================
# HH Bot Dashboard — переменные окружения для Dokploy / Docker
# Скопируй этот файл в .env и заполни значения
# ============================================================

# Пароль для доступа к веб-дашборду (Basic Auth).
# Если не задан — дашборд открыт без пароля (НЕ используй так в продакшне!)
DASHBOARD_PASSWORD=changeme_strong_password

# Включить debug-эндпоинты (/api/debug/*).
# Оставь пустым или "false" в продакшне.
DEBUG_MODE=false

# Отключить SSL-верификацию для исходящих запросов к hh.ru.
# Оставь пустым (=включена) если нет MITM-прокси или корп. сертификатов.
DISABLE_SSL_VERIFY=
